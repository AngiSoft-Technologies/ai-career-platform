{
  "name": "@angisoft/browser-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated Playwright runtime for the guided application workspace",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "playwright": "1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
