{
  "name": "@angisoft/job-radar-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "grpc": "tsx src/grpc/server.ts",
    "embed": "tsx src/db/embed.ts",
    "embed:prod": "node dist/db/embed.js",
    "ingest": "tsx src/db/ingest.ts",
    "worker": "tsx src/worker/run.ts"
  },
  "dependencies": {
    "@angisoft/job-radar-contracts": "*",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@types/pdfkit": "^0.17.7",
    "bullmq": "^6.4.2",
    "cors": "^2.8.6",
    "docx": "^9.14.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "graphql": "^17.0.2",
    "graphql-yoga": "^6.0.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "build": "tsup src/index.ts src/grpc/server.ts src/db/migrate.ts src/db/seed.ts src/db/embed.ts src/db/ingest.ts --format esm --out-dir dist --sourcemap"
}
