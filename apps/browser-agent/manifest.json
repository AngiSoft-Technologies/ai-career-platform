{
  "manifest_version": 3,
  "name": "MboQara Application Agent",
  "description": "Lets an approved MboQara application package operate inside the employer form.",
  "version": "0.1.0",
  "private": true,
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "MboQara Application Agent"
  }
}
