# n8n Version - Latest stable from https://github.com/n8n-io/n8n/releases
N8N_VERSION=1.78.1

# Sandbox Version - Latest stable from https://github.com/n8n-io/n8n-sandbox-service/releases
N8N_SANDBOX_VERSION=0.2.1

# n8n Encryption Key - Generate with: openssl rand -hex 16
# KEEP THIS SECRET - Used to encrypt credentials in n8n database
N8N_ENCRYPTION_KEY=your_32_char_encryption_key_here

# n8n Basic Auth
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_strong_password_here

# n8n Host Configuration
N8N_HOST=n8n.yourdomain.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.yourdomain.com/

# Database - Use Neon PostgreSQL (existing infrastructure)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=your-neon-host.neon.tech
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=neondb
DB_POSTGRESDB_USER=your_neon_user
DB_POSTGRESDB_PASSWORD=your_neon_password
DB_POSTGRESDB_SSL_MODE=require

# n8n Runners (for Code node execution)
N8N_RUNNERS_AUTH_TOKEN=your_runners_auth_token_here
N8N_RUNNERS_TASK_BROKER_URI=http://n8n:5679
N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT=15

# Sandbox Configuration (for n8n Assistant)
N8N_SANDBOX_VERSION=0.2.1
N8N_RUNNERS_AUTH_TOKEN=your_runners_auth_token_here
N8N_SANDBOX_SERVICE_API_KEY=your_sandbox_api_key_here

# Sandbox Service Secrets
SANDBOX_API_KEYS=your_sandbox_api_keys_here
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=your_runner_registration_token_here
SANDBOX_API_RUNNER_API_KEY=your_runner_api_key_here
N8N_SANDBOX_SERVICE_API_KEY=your_sandbox_api_key_here

# SearXNG Configuration (Web Search for n8n Assistant)
SEARXNG_SECRET=your_searxng_secret_here
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# AI Provider Keys (Optional - for n8n Assistant)
# N8N_INSTANCE_AI_MODEL_API_KEY=sk-ant-xxx
# INSTANCE_AI_BRAVE_SEARCH_API_KEY=BSA-xxx

# SearXNG Configuration
SEARXNG_SECRET=your_searxng_secret_here
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# Sandbox Service Configuration
N8N_SANDBOX_VERSION=0.2.1
N8N_RUNNERS_AUTH_TOKEN=your_runners_auth_token_here
N8N_SANDBOX_SERVICE_API_KEY=your_sandbox_api_key_here

# Sandbox Runner Authentication
N8N_RUNNERS_AUTH_TOKEN=your_runners_auth_token_here
N8N_RUNNERS_TASK_BROKER_URI=http://n8n:5679
N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT=15

# Sandbox API Keys
SANDBOX_API_KEYS=your_sandbox_api_keys_here
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=your_runner_registration_token_here
SANDBOX_API_RUNNER_API_KEY=your_runner_api_key_here
N8N_SANDBOX_SERVICE_API_KEY=your_sandbox_api_key_here

# SearXNG
SEARXNG_SECRET=your_searxng_secret_here
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# n8n Instance AI (Optional - for n8n Assistant)
# N8N_INSTANCE_AI_MODEL_API_KEY=sk-ant-xxx
# INSTANCE_AI_BRAVE_SEARCH_API_KEY=BSA-xxx

# Webhook URL for external triggers
WEBHOOK_URL=https://n8n.yourdomain.com/

# n8n Configuration
N8N_EDITOR_BASE_URL=https://n8n.yourdomain.com/
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=true
N8N_PERSONALIZATION_ENABLED=false

# Timezone
GENERIC_TIMEZONE=UTC
TZ=UTC

# Logging
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console