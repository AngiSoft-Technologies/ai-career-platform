# Job Radar - local development environment
# Copy to .env. Never commit real secrets.

NODE_ENV=development
PORT=8088
API_URL=http://localhost:8088/v1
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8088/v1

# Postgres (docker-compose)
DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar
DIRECT_DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar

# Redis / cache / queues
REDIS_URL=redis://localhost:6379

# Object storage (local MinIO, Tigris in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Internal gRPC (optional; falls back to in-process matching)
MATCHING_GRPC_URL=http://localhost:50051
GRPC_PORT=50051

# Demo identity until OAuth is wired
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
DEMO_MODE=true
JWT_SECRET=replace-with-a-long-random-string

# AI provider (optional for initial seed/demo)
# Free tier: get an NVIDIA key at https://build.nvidia.com (starts with nvapi-)
# Other OpenAI-compatible options: AI_BASE_URL + AI_API_KEY (Groq, Cerebras,
# OpenRouter free models, Google Gemini OpenAI-compat endpoint, local Ollama)
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_PROVIDER=auto
AI_BASE_URL=
AI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2

# Neon (production)
# DATABASE_URL and DATABASE_URL_UNPOOLED come from neon env pull
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_REALTIME_URL=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Fly.io production notes
# fly secrets import < .env.local
# fly secrets set REDIS_URL=...
# fly deploy
# Set DEMO_MODE=false once the mobile/web clients use Neon Auth tokens.
