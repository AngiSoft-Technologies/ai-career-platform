{
  "name": "MboQara",
  "version": "0.1.0",
  "private": true,
  "description": "MboQara - AI-powered career intelligence by AngiSoft Technologies",
  "workspaces": [
    "services/api",
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @angisoft/mboqara-api",
    "dev:web": "npm run dev -w @angisoft/mboqara-web",
    "build": "npm run build -w @angisoft/mboqara-api && npm run build -w @angisoft/mboqara-web",
    "typecheck": "npm run typecheck -w @angisoft/mboqara-api",
    "typecheck:web": "npm run typecheck -w @angisoft/mboqara-web",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run check:boundaries && npm run typecheck && npm run typecheck:web",
    "verify": "tsx scripts/verify-web-data-port.ts && tsx scripts/verify-engine-primitives.ts",
    "verify:db": "tsx scripts/verify-db-regressions.ts",
    "db:migrate": "npm run db:migrate -w @angisoft/mboqara-api",
    "db:seed": "npm run db:seed -w @angisoft/mboqara-api",
    "grpc": "npm run grpc -w @angisoft/mboqara-api",
    "web": "npm run dev -w @angisoft/mboqara-web",
    "worker": "npm run worker -w @angisoft/mboqara-api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5"
  }
}
